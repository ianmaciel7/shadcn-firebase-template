# Firebase Web SDK Configuration
# For production: obtain credentials from Firebase Console (Project settings > General > Your apps)
# For local emulator: use a demo project ID prefix ('demo-*') and local emulator host
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=false

# Firebase Local Emulator Suite (Official Firebase environment variables)
# Omit protocol prefix (e.g. 127.0.0.1:9099 or localhost:9099)
FIREBASE_AUTH_EMULATOR_HOST=
GCLOUD_PROJECT=

# Test credentials for emulator test runners and seed scripts
TEST_USER_PASSWORD=

# Example .env configuration for local emulator development:
# NEXT_PUBLIC_FIREBASE_API_KEY=emulator-only
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-test.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-test
# NEXT_PUBLIC_FIREBASE_APP_ID=emulator-only
# NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GCLOUD_PROJECT=demo-test
# TEST_USER_PASSWORD=Test-password-123
