language js

or {
  `$state.status === "error"` as $check,
  `$state.status == "error"` as $check,
  `$state.status !== "error"` as $check,
  `$state.status != "error"` as $check,
  `"error" === $state.status` as $check,
  `"error" == $state.status` as $check,
  `"error" !== $state.status` as $check,
  `"error" != $state.status` as $check,
  `$state.status === "loading"` as $check,
  `$state.status == "loading"` as $check,
  `$state.status !== "loading"` as $check,
  `$state.status != "loading"` as $check,
  `"loading" === $state.status` as $check,
  `"loading" == $state.status` as $check,
  `"loading" !== $state.status` as $check,
  `"loading" != $state.status` as $check
} where {
  register_diagnostic(span=$check, message="Expose isError from the hook and use state.isError or state.isLoading in the component instead of comparing status.", severity="error")
}
