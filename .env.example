# Firebase Web SDK Configuration
# For production: obtain credentials from Firebase Console (Project settings > General > Your apps)
# For local development with Auth Emulator: see commented emulator block below
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=false

# Firebase Auth Emulator Configuration
# Set NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=true for local emulator development.
# When enabled, NEXT_PUBLIC_FIREBASE_PROJECT_ID must start with 'demo-' (e.g. demo-auth-e2e).
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# Example .env.local configuration for local development with emulator:
# NEXT_PUBLIC_FIREBASE_API_KEY=emulator-only
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-auth-e2e.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-auth-e2e
# NEXT_PUBLIC_FIREBASE_APP_ID=emulator-only
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=true
