{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/components/**/*.{ts,tsx}",
    "src/hooks/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/i18n/**/*.ts",
    "src/app/**/_hooks/**/*.{ts,tsx}"
  ],
  "ignorePatterns": [".ladle/**"],
  "health": {
    "ignore": [
      "src/components/ai-elements/**",
      "src/components/firebase/**",
      "src/components/ui/*.tsx",
      "src/app/(protected)/profile/_components/profile-submit.ts",
      "scripts/emulator/seed.mjs",
      "scripts/emulator/clear.mjs",
      "**/*.stories.tsx"
    ]
  }
}
